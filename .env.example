# Optional: enables GPT-powered answers instead of the built-in catalog assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required in production for authorized stock refresh (POST /api/availability/refresh).
# Generate with: openssl rand -hex 32
AVAILABILITY_CRON_SECRET=

# Local dev URL for the scheduled refresh worker (defaults to http://localhost:3000).
KEYSOL_BASE_URL=http://localhost:3000

# Required in production for user sessions. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional override for the SQLite auth database (defaults to data/auth.db).
AUTH_DATABASE_PATH=

# Optional email delivery for verification and password reset (Resend).
RESEND_API_KEY=
EMAIL_FROM=KeySol <noreply@keysol.app>

# Dev only: allow unauthenticated cron refresh when no cron secret is set.
ALLOW_INSECURE_CRON=true

# Set to true when deployed behind a trusted reverse proxy (Vercel sets this automatically).
TRUST_PROXY_HEADERS=

# Comma-separated admin emails allowed to review keyboard drops at /admin/drops.
ADMIN_EMAILS=
