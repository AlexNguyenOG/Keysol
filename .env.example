# Optional: enables GPT-powered answers instead of the built-in catalog assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required in production for authorized stock refresh (POST /api/availability/refresh)
# and admin drop review APIs (/api/admin/drops/*).
# Generate with: openssl rand -hex 32
AVAILABILITY_CRON_SECRET=

# Local dev URL for the scheduled refresh worker (defaults to http://localhost:3000).
KEYSOL_BASE_URL=http://localhost:3000

# Optional override for the SQLite app database (defaults to data/app.db).
APP_DATABASE_PATH=

# Dev only: allow unauthenticated cron/admin requests when no cron secret is set.
ALLOW_INSECURE_CRON=true

# Set to true when deployed behind a trusted reverse proxy (Vercel sets this automatically).
TRUST_PROXY_HEADERS=

# Optional override for the footer author link (defaults to https://alexnguyenog.vercel.app).
NEXT_PUBLIC_AUTHOR_URL=
