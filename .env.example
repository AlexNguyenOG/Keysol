# Optional: enables GPT-powered answers instead of the built-in catalog assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required in production for authorized stock refresh (POST /api/availability/refresh)
# and drop detection (/api/drops/detect). Generate with: openssl rand -hex 32
AVAILABILITY_CRON_SECRET=

# Optional dedicated admin secret for /api/admin/drops/*.
# Falls back to AVAILABILITY_CRON_SECRET when unset. Generate with: openssl rand -hex 32
ADMIN_API_SECRET=

# Local dev URL for the scheduled refresh worker (defaults to http://localhost:3000).
KEYSOL_BASE_URL=http://localhost:3000

# Optional override for the local SQLite app database (defaults to data/app.db).
# Ignored when TURSO_DATABASE_URL is set.
APP_DATABASE_PATH=

# Required on Vercel for durable drop candidates / published drops (Turso / libSQL).
# Local dev can omit these and use the file database above.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Dev only: allow unauthenticated cron/admin requests when no cron secret is set.
# Never enable this in production.
ALLOW_INSECURE_CRON=true

# Set to true when deployed behind a trusted reverse proxy (Vercel sets this automatically).
TRUST_PROXY_HEADERS=

# Optional override for the footer author link (defaults to https://alexnguyenog.vercel.app).
NEXT_PUBLIC_AUTHOR_URL=

# --- Solana token collectibles ---
# Enable wallet claim UI on /tokens
NEXT_PUBLIC_TOKENIZATION_ENABLED=true
# Surfpool localnet (recommended for testing):
NEXT_PUBLIC_SOLANA_CLUSTER=localnet
NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899
# Or Devnet public pilot (2 lowest catalog boards by default):
# NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Then: npm run tokens:devnet:create
# Commit src/data/token-mints.devnet.json so the Token Guide publishes mint addresses.

# Mint authority keypair (created by tokens:*:create)
TOKEN_MINT_AUTHORITY_KEYPAIR=.keys/mint-authority.json

# Offline UI-only claims (no chain). Keep false when using Surfpool/Devnet.
TOKEN_CLAIM_SIMULATION=false

# Mint script knobs (optional):
# TOKEN_MINT_LIMIT=2
# TOKEN_MINT_PICK=lowest
# TOKEN_MINT_INCLUDE_DROPS=true
