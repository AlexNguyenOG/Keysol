{
  "name": "keyboard-finder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:daemon": "npx pm2 start ecosystem.config.cjs",
    "dev:daemon:stop": "npx pm2 stop keysol-dev keysol-availability-cron",
    "dev:daemon:restart": "npx pm2 restart keysol-dev keysol-availability-cron",
    "dev:daemon:status": "npx pm2 status keysol-dev keysol-availability-cron",
    "dev:daemon:logs": "npx pm2 logs keysol-dev keysol-availability-cron --lines 50",
    "dev:ensure": "node scripts/ensure-dev-server.mjs",
    "availability:cron": "node scripts/availability-cron.mjs",
    "availability:refresh": "tsx scripts/refresh-availability.ts",
    "availability:snapshot": "node scripts/update-availability-snapshot.mjs",
    "tokens:baseline": "tsx scripts/update-token-baseline.ts",
    "showcase:fetch": "node scripts/fetch-keyboard-showcases.mjs",
    "build": "next build",
    "check:production-env": "node scripts/check-production-env.mjs",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run audit:ci && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pm2": "^7.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
