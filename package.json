{
  "name": "keyboard-finder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:daemon": "pm2 start ecosystem.config.cjs",
    "dev:daemon:stop": "pm2 stop keysol-dev keysol-availability-cron",
    "dev:daemon:restart": "pm2 restart keysol-dev keysol-availability-cron",
    "dev:daemon:status": "pm2 status keysol-dev keysol-availability-cron",
    "dev:daemon:logs": "pm2 logs keysol-dev keysol-availability-cron --lines 50",
    "dev:ensure": "node scripts/ensure-dev-server.mjs",
    "availability:cron": "node scripts/availability-cron.mjs",
    "availability:refresh": "tsx scripts/refresh-availability.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pm2": "^7.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
